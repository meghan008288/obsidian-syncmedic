{
  "name": "syncmedic",
  "version": "0.1.9",
  "description": "Local diagnostics for Obsidian sync failures. Scans your logs on your own machine, matches them against real upstream issue signatures, and tells you exactly how to fix it. Nothing leaves your machine.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:fingerprints": "node scripts/check_fingerprints.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "remotely-save",
    "livesync",
    "diagnostics"
  ],
  "author": "Meghan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
